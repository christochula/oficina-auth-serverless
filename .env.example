# Apenas identificadores/configuracoes. Valores de banco, senha e chave JWT ficam no Secrets Manager.
AWS_REGION=us-east-1
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:oficina/homolog/database
JWT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:oficina/homolog/jwt
JWT_TTL_SECONDS=300
JWT_ISSUER=oficina-auth-serverless
JWT_AUDIENCE=oficina-api
JWT_DEFAULT_ROLE=CLIENTE
JWT_DEFAULT_SCOPES=orders:read,orders:write
SECRET_CACHE_TTL_MS=300000
PG_POOL_MAX=4
PG_CONNECTION_TIMEOUT_MS=3000
LOG_LEVEL=info

# Em deploy, o Terraform preenche estas variaveis e anexa as layers oficiais.
DD_ENABLED=false
DD_SERVICE=oficina-auth
DD_ENV=local
DD_VERSION=dev
DD_SITE=datadoghq.com
DD_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:datadog/api-key

# Handler de notificacao; preenchido pelo Terraform quando notification_enabled=true.
NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:oficina-local-notifications
