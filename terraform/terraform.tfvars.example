# Copie para terraform.tfvars (nao versionado) se rodar local.
# No CI os valores vem de TF_VAR_* (GitHub Variables).

aws_region  = "us-east-1"
environment = "homolog"

# AWS Academy: deixe vazio para derivar de account_id
# lab_role_arn = "arn:aws:iam::519768589921:role/LabRole"

# Contratos dos outros repos (preencher no deploy real)
db_secret_arn  = "arn:aws:secretsmanager:us-east-1:519768589921:secret:oficina/homolog/database/connection-XXXXXX"
jwt_secret_arn = "arn:aws:secretsmanager:us-east-1:519768589921:secret:oficina/homolog/jwt-XXXXXX"
backend_url    = "http://<elb-dns-do-eks>"

notification_enabled = true
datadog_enabled      = false
