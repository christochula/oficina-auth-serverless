# Copy to terraform.tfvars (ignored); never put secret values in this file.
aws_region  = "us-east-1"
environment = "homolog"
backend_url            = "http://REPLACE-os-loadbalancer"
billing_backend_url    = "http://REPLACE-billing-loadbalancer"
production_backend_url = "http://REPLACE-production-loadbalancer"
os_client_lookup_url          = "" # derive the HTTPS Gateway URL automatically
auth_client_lookup_secret_arn = "arn:aws:secretsmanager:us-east-1:REPLACE:secret:oficina/homolog/auth-client-lookup-REPLACE"
jwt_secret_arn = "arn:aws:secretsmanager:us-east-1:REPLACE:secret:oficina/homolog/jwt-REPLACE"
notification_enabled = true
datadog_enabled      = false
# datadog_api_key_secret_arn = "arn:aws:secretsmanager:us-east-1:REPLACE:secret:datadog/api-key-REPLACE"
