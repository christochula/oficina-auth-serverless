AWS_REGION=us-east-1
# Production HTTPS API Gateway exact public route; OS checks X-Internal-Token.
OS_CLIENT_LOOKUP_URL=https://REPLACE.execute-api.us-east-1.amazonaws.com/api/v1/internal/auth/cliente
AUTH_CLIENT_LOOKUP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:REPLACE:secret:oficina/homolog/auth-client-lookup-REPLACE
# Loopback only: use instead of ARN when developing locally. Never in GitHub Variables.
# OS_CLIENT_LOOKUP_URL=http://localhost:3000/api/v1/internal/auth/cliente
# AUTH_CLIENT_LOOKUP_TOKEN=replace-with-a-random-token-at-least-32-bytes
CLIENT_LOOKUP_TIMEOUT_MS=5000
JWT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:REPLACE:secret:oficina/homolog/jwt-REPLACE
JWT_TTL_SECONDS=300
JWT_ISSUER=oficina-auth-serverless
JWT_AUDIENCE=oficina-api
JWT_DEFAULT_ROLE=CLIENTE
JWT_DEFAULT_SCOPES=orders:read,orders:write
SECRET_CACHE_TTL_MS=300000
LOG_LEVEL=info
DD_ENABLED=false
DD_SERVICE=oficina-auth
DD_ENV=local
DD_VERSION=dev
DD_SITE=datadoghq.com
DD_API_KEY_SECRET_ARN=arn:aws:secretsmanager:us-east-1:REPLACE:secret:datadog/api-key-REPLACE
NOTIFICATION_TOPIC_ARN=arn:aws:sns:us-east-1:REPLACE:oficina-local-notifications
